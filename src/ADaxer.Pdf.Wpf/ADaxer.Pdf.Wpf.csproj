<Project Sdk="Microsoft.NET.Sdk">

	<!-- Build -->
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>ADaxer.Pdf.Wpf</PackageId>
		<VersionPrefix>1.2.0</VersionPrefix>
		<Authors>Andreas Daxer</Authors>
		<Company>Andreas Daxer - Entwicklung – Schulung – Beratung mit Microsoft.NET</Company>
		<Description>A lightweight WPF PDF viewer control with paging, zooming, fit-to-width/height and scrolling view modes, powered by PDFiumCore.</Description>
		<PackageTags>wpf;pdf;pdf-viewer;pdfium;viewer;control</PackageTags>

		<PackageProjectUrl>https://github.com/adaxer/Pdf.Wpf</PackageProjectUrl>
		<RepositoryUrl>https://github.com/adaxer/Pdf.Wpf</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Copyright>Copyright © 2024-2026 Andreas Daxer</Copyright>

		<PackageReleaseNotes>
			Version 1.2.0 removes the ImageSharp dependency, renders directly to WPF BitmapSource, and improves PDFium resource handling and memory usage.
		</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>portable</DebugType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
		<PackageReference Include="PDFiumCore" Version="151.0.7920" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
		<None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
